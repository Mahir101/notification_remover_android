        <item name="colorSecondaryContainer">@color/brand_secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container_dark</item>

        <item name="colorError">@color/brand_error_dark</item>
        <item name="colorOnError">@color/brand_on_error_dark</item>
        <item name="colorErrorContainer">@color/brand_error_container_dark</item>
        <item name="colorOnErrorContainer">@color/brand_on_error_container_dark</item>

        <item name="android:colorBackground">@color/brand_surface_dark</item>
        <item name="colorSurface">@color/brand_surface_dark</item>
        <item name="colorOnSurface">@color/brand_on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant_dark</item>
        <item name="colorOutline">@color/brand_outline_dark</item>

        <item name="android:statusBarColor">@color/brand_surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/brand_surface_dark</item>
