<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (dark). -->
    <style name="Theme.ZEROFications" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/brand_on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container_dark</item>

        <item name="colorSecondary">@color/brand_secondary_dark</item>
